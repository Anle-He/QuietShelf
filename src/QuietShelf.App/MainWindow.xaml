                                            <Grid ToolTip="{Binding TooltipText}">
                                                <Border x:Name="HeatCell" Margin="3" CornerRadius="5" Background="#EEF1ED" />
                                                <Ellipse x:Name="CompletionDot" Width="6" Height="6" Margin="0,4,4,0" Fill="#C18A2B"
                                                         HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IntensityLevel}" Value="1"><Setter TargetName="HeatCell" Property="Background" Value="#DCEADF" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IntensityLevel}" Value="2"><Setter TargetName="HeatCell" Property="Background" Value="#AFCDB8" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IntensityLevel}" Value="3"><Setter TargetName="HeatCell" Property="Background" Value="#5F8F70" /></DataTrigger>
                                                <DataTrigger Binding="{Binding HasCompletion}" Value="True"><Setter TargetName="CompletionDot" Property="Visibility" Value="Visible" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsFuture}" Value="True"><Setter TargetName="HeatCell" Property="Opacity" Value="0.22" /></DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeatCell" Property="BorderBrush" Value="#6E9B80" /><Setter TargetName="HeatCell" Property="BorderThickness" Value="1" /></Trigger>
                                            </DataTemplate.Triggers>
