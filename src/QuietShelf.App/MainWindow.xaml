<ui:FluentWindow x:Class="QuietShelf.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:models="clr-namespace:QuietShelf.Models"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="QuietShelf · 书影音" Width="1280" Height="800"
                 MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowCornerPreference="Round" Icon="Assets/app-icon.ico"
                 FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
                 FontSize="14" Foreground="{StaticResource TextBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="QuietIconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SectionEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="WidgetShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="#DCE3DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="17,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <DrawingBrush x:Key="DotPatternBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"
                      Viewbox="0,0,16,16" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#70FFFFFF">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="3,3" RadiusX="1.1" RadiusY="1.1" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DataTemplate x:Key="WorkRatingMarkTemplate">
            <Grid Width="74" Height="44" ToolTip="{Binding AggregateRatingMarkLabel}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAggregateRank}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Margin="1,0,1,0">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="20" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path x:Name="RatingStarPrimary" Width="13" Height="13" Stretch="Uniform"
                                  Fill="#A95F32" Stroke="#6F3A21" StrokeThickness="0.6"
                                  Data="M 7,0 L 8.7,5.3 L 14,7 L 8.7,8.7 L 7,14 L 5.3,8.7 L 0,7 L 5.3,5.3 Z"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Path x:Name="RatingStarSecondary" Width="8" Height="8" Stretch="Uniform"
                                  Fill="#C9CED2" Stroke="#6F777D" StrokeThickness="0.65" Visibility="Collapsed"
                                  Data="M 7,0 L 8.7,5.3 L 14,7 L 8.7,8.7 L 7,14 L 5.3,8.7 L 0,7 L 5.3,5.3 Z"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <Path x:Name="RatingStarTertiary" Width="6" Height="6" Stretch="Uniform"
                                  Fill="#E0B84F" Stroke="#8A621A" StrokeThickness="0.7" Visibility="Collapsed"
                                  Data="M 7,0 L 8.7,5.3 L 14,7 L 8.7,8.7 L 7,14 L 5.3,8.7 L 0,7 L 5.3,5.3 Z"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,0" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="RANK" FontSize="7.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,-1,0,0">
                                <TextBlock x:Name="RatingValue" Text="{Binding AggregateRankValueLabel}" FontSize="17"
                                           FontWeight="SemiBold" Foreground="#2F664B" />
                                <TextBlock x:Name="RatingMaximum" Text="{Binding AggregateRankMaximumLabel}" Margin="3,7,0,0"
                                           FontSize="9" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="RatingRule" Grid.Row="1" Width="70" Height="3" CornerRadius="2" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#35684E" Offset="0" />
                                <GradientStop Color="#C6994A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding AggregateScoreTier}" Value="silver">
                        <Setter TargetName="RatingStarPrimary" Property="Fill" Value="#C9CED2" />
                        <Setter TargetName="RatingStarPrimary" Property="Stroke" Value="#6F777D" />
                        <Setter TargetName="RatingStarSecondary" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AggregateScoreTier}" Value="gold">
                        <Setter TargetName="RatingStarPrimary" Property="Fill" Value="#E0B84F" />
                        <Setter TargetName="RatingStarPrimary" Property="Stroke" Value="#8A621A" />
                        <Setter TargetName="RatingStarSecondary" Property="Fill" Value="#E0B84F" />
                        <Setter TargetName="RatingStarSecondary" Property="Stroke" Value="#8A621A" />
                        <Setter TargetName="RatingStarSecondary" Property="Visibility" Value="Visible" />
                        <Setter TargetName="RatingStarTertiary" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ShowcaseRankItemTemplate">
            <Button Tag="{Binding}" Click="DashboardShowcase_Open" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand" HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="9" CornerRadius="12" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="#DCE4DE" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="48" CornerRadius="5" Background="{StaticResource AccentSoftBrush}" ClipToBounds="True">
                                    <Grid><TextBlock Text="{Binding KindGlyph}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=80}" Stretch="UniformToFill"/></Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CompletionLabel}" Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding RankLabel}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource ScoreBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding RankMaximumLabel}" FontSize="9" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentLineBrush}"/><Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="RecentShowcaseItemTemplate">
            <Button Tag="{Binding}" Click="DashboardShowcase_Open" Width="116" Margin="0,0,10,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Button.Template><ControlTemplate TargetType="Button"><StackPanel>
                    <Border x:Name="CoverSurface" Width="92" Height="132" CornerRadius="9" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid><TextBlock Text="{Binding KindGlyph}" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=184}" Stretch="UniformToFill"/></Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" Width="108" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    <TextBlock Text="{Binding LatestDateLabel}" Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CoverSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="CoverSurface" Property="Effect" Value="{StaticResource CardShadow}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            </Button>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="QuietShelf · 书影音" Icon="Assets/app-icon.ico" />

        <Grid Grid.Row="1" Background="{StaticResource PageBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="324" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="10,10,8,10" Background="{StaticResource LibraryPaneBrush}"
                    BorderBrush="#D7DED8" BorderThickness="1" CornerRadius="22" Effect="{StaticResource CardShadow}">
                <Grid Margin="18,20,18,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="10" Background="{StaticResource AccentStrongBrush}">
                                    <TextBlock Text="Q" FontFamily="Georgia" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,-1,0,0">
                                    <TextBlock Text="QuietShelf" FontFamily="Georgia" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LibraryCountText" Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Text="0 部作品" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:Button x:Name="HomeButton" Appearance="Secondary" Icon="{ui:SymbolIcon Home24}"
                                       ToolTip="首页" AutomationProperties.Name="首页" Width="36" Height="36" Padding="0" Click="Home_Click" />
                            <ui:Button Margin="7,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                                       ToolTip="收录作品" AutomationProperties.Name="收录作品"
                                       Click="AddWork_Click" Width="36" Height="36" Padding="0" />
                        </StackPanel>
                    </Grid>

                    <ui:TextBox x:Name="SearchBox" Grid.Row="2" Margin="0,18,0,0" Height="40"
                                PlaceholderText="搜索标题、副标题或作者" TextChanged="SearchBox_TextChanged" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button x:Name="AllFilterButton" Content="全部" Tag="all" Appearance="Primary" Click="Filter_Click" Padding="13,4" />
                        <ui:Button x:Name="BookFilterButton" Content="书籍" Tag="book" Appearance="Secondary" Margin="6,0,0,0" Click="Filter_Click" Padding="13,4" />
                        <ui:Button x:Name="ScreenFilterButton" Content="影视" Tag="screen" Appearance="Secondary" Margin="6,0,0,0" Click="Filter_Click" Padding="13,4" />
                    </StackPanel>

                    <Grid x:Name="RegularWorksHeader" Grid.Row="5" Margin="2,14,2,8">
                        <TextBlock Text="作品" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedStrongBrush}" />
                        <TextBlock Text="按最近记录" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                    <Grid Grid.Row="6">
                        <Border x:Name="EmptyState" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="48" Height="48" Background="{StaticResource AccentSoftBrush}" CornerRadius="16">
                                    <ui:SymbolIcon Symbol="Book24" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="EmptyTitle" Text="这里还没有作品" Margin="0,14,0,0" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyDescription" Text="先加入一本书，或一部想留下来的影视。" Margin="0,7,0,16"
                                           Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                <ui:Button Content="添加第一部作品" Appearance="Primary" Click="AddWork_Click" />
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="WorkList" ItemsSource="{Binding VisibleWorks}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="WorkList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <Border x:Name="ItemSurface" Padding="11" CornerRadius="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter /></Border>
                                                    <Border x:Name="SelectionMark" Width="3" Height="30" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource SurfaceBrush}" /><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#D9E1DA" /></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource SurfaceBrush}" /><Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" /><Setter TargetName="ItemSurface" Property="Effect" Value="{StaticResource CardShadow}" /><Setter TargetName="SelectionMark" Property="Opacity" Value="1" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="60" CornerRadius="5" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=84}" Stretch="UniformToFill">
                                                    <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPrimaryCover}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding KindGlyph}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasPrimaryCover}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" FontSize="10.8" Foreground="{StaticResource MutedStrongBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding ExperienceSummaryLabel, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding LatestActivityLabel, Mode=OneWay}" Margin="0,3,0,0" FontSize="9.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource WorkRatingMarkTemplate}"
                                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="0,10,10,10" Background="{StaticResource DetailPaneBrush}">
                <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,24,32,38">
                        <Border x:Name="DashboardHero" Height="302" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="#D8E0D9" BorderThickness="1" CornerRadius="26" ClipToBounds="True"
                                Effect="{StaticResource HeroShadow}">
                            <Grid>
                                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                    <Ellipse Width="430" Height="430" Canvas.Left="570" Canvas.Top="-104" Fill="#CFE2D6" />
                                    <Ellipse Width="244" Height="244" Canvas.Left="700" Canvas.Top="18" Fill="#F2DFC4" Stroke="#D7B97E" StrokeThickness="1" />
                                    <Ellipse Width="112" Height="112" Canvas.Left="638" Canvas.Top="138" Fill="#E4B75F" Opacity="0.82" />
                                    <Path Data="M 500,270 C 650,132 805,84 1010,110" Stroke="#7DA48D" StrokeThickness="1.4" />
                                    <Path Data="M 590,286 C 720,190 846,166 1015,183" Stroke="#B17A31" StrokeThickness="1.2" StrokeDashArray="3,8" />
                                    <Ellipse Width="8" Height="8" Canvas.Left="595" Canvas.Top="58" Fill="#B15F48" />
                                </Canvas>

                                <Grid x:Name="DashboardHeroEmptyContent" Margin="32,26">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="私人书影音档案" Style="{StaticResource SectionEyebrow}" />
                                        <TextBlock Text="把完成的作品留在这里" Margin="0,14,0,0" FontSize="36" FontWeight="SemiBold" />
                                        <TextBlock Text="书、影视和感受，会在这里慢慢形成你的私人档案。" Margin="0,10,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                                        <ui:Button Content="收录作品" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="0,22,0,0" HorizontalAlignment="Left" Padding="17,8" Click="AddWork_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource MetricCard}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"><ui:SymbolIcon Symbol="Book24" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Margin="11,-1,0,0"><TextBlock Text="收藏" FontSize="10.5" Foreground="{StaticResource MutedBrush}" /><StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock x:Name="DashboardWorkCountText" Text="0" FontSize="24" FontWeight="SemiBold" /><TextBlock Text=" 部作品" Margin="6,9,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}" /></StackPanel></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="10" Background="#E3EEE8"><Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Margin="11,-1,0,0"><TextBlock Text="有感" FontSize="10.5" Foreground="{StaticResource MutedBrush}" /><StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock x:Name="DashboardActiveCountText" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /><TextBlock Text=" 次评分" Margin="6,9,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}" /></StackPanel></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource WarmSoftBrush}"><ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Foreground="{StaticResource WarmBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Margin="11,-1,0,0"><TextBlock Text="完成" FontSize="10.5" Foreground="{StaticResource MutedBrush}" /><StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock x:Name="DashboardExperienceCountText" Text="0" FontSize="24" FontWeight="SemiBold" /><TextBlock Text=" 条记录" Margin="6,9,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}" /></StackPanel></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="DashboardShowcasePanel" Margin="0,24,0,0">
                            <Grid Margin="2,0,2,12">
                                <StackPanel><TextBlock Text="CURATED / 收藏回顾" Style="{StaticResource SectionEyebrow}"/><TextBlock Text="从完成记录里重新发现" Margin="0,5,0,0" Style="{StaticResource SectionTitle}"/></StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource WidgetShell}"><Border Background="{StaticResource SurfaceBrush}" CornerRadius="17" Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"><ui:SymbolIcon Symbol="Book24" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="书籍评分榜" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Grid>
                                        <ItemsControl ItemsSource="{Binding DashboardTopBooks}" ItemTemplate="{StaticResource ShowcaseRankItemTemplate}"/>
                                        <TextBlock Text="还没有完整评分的书籍" Margin="4,10" Foreground="{StaticResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DashboardTopBooks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </StackPanel>
                                </Border></Border>
                                <Border Grid.Column="2" Style="{StaticResource WidgetShell}"><Border Background="{StaticResource SurfaceBrush}" CornerRadius="17" Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource WarmSoftBrush}"><ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="16" Foreground="{StaticResource WarmBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="影视评分榜" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Grid>
                                        <ItemsControl ItemsSource="{Binding DashboardTopScreens}" ItemTemplate="{StaticResource ShowcaseRankItemTemplate}"/>
