                                    <TextBlock Text="少" Margin="0,1,7,0" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    <Border Width="12" Height="12" CornerRadius="3" Background="#EEF1ED" />
                                    <Border Width="12" Height="12" Margin="4,0,0,0" CornerRadius="3" Background="#DCEADF" />
                                    <Border Width="12" Height="12" Margin="4,0,0,0" CornerRadius="3" Background="#AFCDB8" />
                                    <Border Width="12" Height="12" Margin="4,0,0,0" CornerRadius="3" Background="#5F8F70" />
