                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Grid.Row="1" Width="32" Height="210">
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="一" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="三" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="4" Text="五" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="6" Text="日" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DashboardHeatmapDays}" Width="360" Height="210">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="7" Columns="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
