                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EventSurface" Property="Background" Value="#EDF4EF" /></Trigger>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EventSurface" Property="Background" Value="#DCECE3" /></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
