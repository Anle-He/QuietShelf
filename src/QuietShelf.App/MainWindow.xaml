                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="DashboardTimelineList" ItemsSource="{Binding DashboardTimelineDays}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,16,0,0">
                                            <TextBlock Text="{Binding DateLabel}" FontFamily="Georgia" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="1,5,0,0">
                                                <TextBlock Text="{Binding YearLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding WeekdayLabel}" Margin="7,0,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="1" Background="{StaticResource TimelineBrush}" HorizontalAlignment="Center" />
                                        <Ellipse Grid.Column="1" Width="9" Height="9" Margin="0,25,0,0" VerticalAlignment="Top"
                                                 Fill="{StaticResource DetailPaneBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                                        <Border Grid.Column="2" Margin="14,0,0,20" Padding="6" Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="#D7E0D8" BorderThickness="1" CornerRadius="18" Effect="{StaticResource CardShadow}">
