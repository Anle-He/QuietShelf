                            <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,12,26,0">
                                <TextBlock Text="节律" Style="{StaticResource SectionEyebrow}" />
                                <TextBlock Text="最近 12 周" Margin="0,5,0,0" Style="{StaticResource SectionTitle}" />
