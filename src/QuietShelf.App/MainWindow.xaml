                                <Border Width="40" Height="40" Background="{StaticResource AccentSoftBrush}" CornerRadius="20">
                                    <ui:SymbolIcon Symbol="Edit24" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="13,1,0,0">
                                    <TextBlock Text="第一条轨迹，从一次记录开始" FontSize="14" FontWeight="SemiBold" />
