                            <StackPanel>
                                <Grid>
                                    <StackPanel><TextBlock Text="正在进行" Style="{StaticResource SectionEyebrow}" /><TextBlock x:Name="ActiveDateText" Margin="0,7,0,0" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="ActiveSummaryText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" /></StackPanel>
