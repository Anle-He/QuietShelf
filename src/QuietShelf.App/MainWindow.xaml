                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="EventSurface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="15,13">
                                                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                                                    </Border>
