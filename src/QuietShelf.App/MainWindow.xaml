                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                        </Border>

                        <Border Margin="0,18,0,0" Padding="26,22,26,8" Background="#E4EAE4" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="24">
