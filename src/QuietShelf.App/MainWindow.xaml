                                                     Fill="{StaticResource DetailPaneBrush}" Stroke="#A95F32" StrokeThickness="3" />
                                        </Canvas>
                                        <Border x:Name="ArchiveCard" Grid.Column="1" BorderBrush="#D8E2DC" BorderThickness="1" CornerRadius="18" Padding="20,18" Margin="0,8,0,8" ClipToBounds="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F7FAF7" Offset="0" />
                                                    <GradientStop Color="#FBF8F1" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid TextElement.FontFamily="Segoe UI Variable Display, Microsoft YaHei UI">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="348" /><ColumnDefinition Width="*" /><ColumnDefinition Width="274" /></Grid.ColumnDefinitions>

                                                <Grid VerticalAlignment="Center" Margin="0,0,18,0">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <Grid HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding JourneyLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                        <ui:Button x:Name="ArchiveActions" Grid.Column="1" Tag="{Binding Experience}" Icon="{ui:SymbolIcon MoreHorizontal24}" ToolTip="更多"
                                                                   Width="30" Height="26" Margin="8,0,0,0" Padding="0" VerticalAlignment="Center"
                                                                   Opacity="0.2" Click="ArchiveMore_Click">
                                                            <ui:Button.ContextMenu>
                                                                <ContextMenu Placement="Bottom">
                                                                    <MenuItem Header="编辑这次旅程" Click="EditExperience_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                                    <Separator />
                                                                    <MenuItem Header="删除这次旅程" Click="DeleteExperience_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                                </ContextMenu>
                                                            </ui:Button.ContextMenu>
                                                        </ui:Button>
                                                    </Grid>
                                                    <Grid Grid.Row="1" Height="62" Margin="0,17,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Border Grid.ColumnSpan="3" Height="1" Margin="18,0,18,6" Background="#A9BCAF" VerticalAlignment="Bottom" />
                                                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,0,2.5" Fill="{StaticResource DetailPaneBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                                        <Ellipse Grid.Column="1" Width="8" Height="8" Margin="0,0,0,2.5" Fill="{StaticResource DetailPaneBrush}" Stroke="#B8862E" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                        <Ellipse Grid.Column="2" Width="8" Height="8" Margin="0,0,0,2.5" Fill="{StaticResource DetailPaneBrush}" Stroke="#B8862E" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                        <StackPanel>
                                                            <TextBlock Text="启程" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                            <TextBlock Text="{Binding StartDateLabel}" Margin="0,2,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border Height="2" Width="54" Background="#BEA35D" CornerRadius="1" />
                                                            <TextBlock Text="{Binding JourneyDaysLabel}" Margin="0,5,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                            <TextBlock Text="抵达" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding EndDateLabel}" Margin="0,2,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                                                        <TextBlock Text="{Binding ActivityDaysLabel}" FontSize="12.5" Foreground="{StaticResource MutedStrongBrush}" />
                                                        <TextBlock Text="{Binding ProgressAmountLabel}" Margin="14,0,0,0" FontSize="12.5" Foreground="{StaticResource MutedStrongBrush}">
                                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasProgressAmount}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Column="1" Margin="20,0,24,0">
                                                    <TextBlock Text="“" FontFamily="Georgia" FontSize="48" Foreground="{StaticResource AccentBrush}" Opacity="0.16"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-13,0,0">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasNotes}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Notes}" Margin="18,18,8,0" FontSize="14" LineHeight="23" TextWrapping="Wrap" MaxHeight="72"
                                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasNotes}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <Grid x:Name="DimensionScores" Grid.Column="2" Width="274" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.FontFamily="Monotype Corsiva, Gabriola, Palatino Linotype" TextElement.FontWeight="Normal">
                                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasCompleteRating}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                    <Grid.Resources>
                                                        <Style x:Key="DimensionName" TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="25" />
                                                            <Setter Property="Foreground" Value="{StaticResource MutedStrongBrush}" />
                                                        </Style>
                                                        <Style x:Key="DimensionScore" TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="44" />
                                                            <Setter Property="Foreground" Value="{StaticResource ScoreBrush}" />
                                                            <Setter Property="Margin" Value="0,4,0,0" />
                                                        </Style>
                                                    </Grid.Resources>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource DimensionName}" AutomationProperties.Name="Allure"><Run Text="All" FontSize="32" Foreground="{StaticResource AccentBrush}" /><Run Text="ure" /></TextBlock>
                                                        <TextBlock Style="{StaticResource DimensionScore}"><Run Text="{Binding Allure, Mode=OneWay}" /><Run Text="{Binding Source={x:Static models:RatingScale.AllureMaximum}, Mode=OneWay, StringFormat=' / {0}'}" FontSize="18" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource DimensionName}" AutomationProperties.Name="Immersion"><Run Text="Imm" FontSize="32" Foreground="{StaticResource AccentBrush}" /><Run Text="ersion" /></TextBlock>
                                                        <TextBlock Style="{StaticResource DimensionScore}"><Run Text="{Binding Immersion, Mode=OneWay}" /><Run Text="{Binding Source={x:Static models:RatingScale.DimensionMaximum}, Mode=OneWay, StringFormat=' / {0}'}" FontSize="18" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="2">
                                                        <TextBlock Style="{StaticResource DimensionName}" AutomationProperties.Name="Rationality"><Run Text="Rat" FontSize="32" Foreground="{StaticResource AccentBrush}" /><Run Text="ionality" /></TextBlock>
                                                        <TextBlock Style="{StaticResource DimensionScore}"><Run Text="{Binding Rationality, Mode=OneWay}" /><Run Text="{Binding Source={x:Static models:RatingScale.DimensionMaximum}, Mode=OneWay, StringFormat=' / {0}'}" FontSize="18" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                                        <TextBlock Style="{StaticResource DimensionName}" AutomationProperties.Name="Illumination"><Run Text="Ill" FontSize="32" Foreground="{StaticResource AccentBrush}" /><Run Text="umination" /></TextBlock>
                                                        <TextBlock Style="{StaticResource DimensionScore}"><Run Text="{Binding Illumination, Mode=OneWay}" /><Run Text="{Binding Source={x:Static models:RatingScale.DimensionMaximum}, Mode=OneWay, StringFormat=' / {0}'}" FontSize="18" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock x:Name="IncompleteRating" Grid.Column="2" Text="评分未完成" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasCompleteRating}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>

                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RatingTier}" Value="silver">
                                            <Setter TargetName="TimelineNode" Property="Stroke" Value="#7D878D" />
                                            <Setter TargetName="ArchiveCard" Property="BorderBrush" Value="#D4DADD" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RatingTier}" Value="gold">
                                            <Setter TargetName="TimelineNode" Property="Stroke" Value="#B8841E" />
                                            <Setter TargetName="ArchiveCard" Property="BorderBrush" Value="#D9C48E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasCompleteRating}" Value="False">
                                            <Setter TargetName="TimelineNode" Property="Stroke" Value="#8E9993" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}, Path=IsMouseOver}" Value="True">
                                            <Setter TargetName="ArchiveActions" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
