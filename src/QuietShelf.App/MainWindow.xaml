                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="10,1,18,0">
                                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                                                                    <TextBlock x:Name="TimelineAction" Text="{Binding ActionLabel}" Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource MutedStrongBrush}" />
                                                                    <Border x:Name="TimelineNote" Margin="0,12,0,2" BorderBrush="#D3DFD4" BorderThickness="2,0,0,0" Padding="10,0,0,0">
                                                                        <TextBlock Text="{Binding NotesExcerpt}" FontSize="12" LineHeight="20" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                    <Border x:Name="EventBadge" Padding="9,4" CornerRadius="10" Background="#F2F5F1">
                                                                        <TextBlock x:Name="EventBadgeText" Text="{Binding EventLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                                    </Border>
                                                                    <TextBlock Text="打开作品  →" Margin="0,10,1,0" FontSize="10" Foreground="#7B8B7E" HorizontalAlignment="Right" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding HasNotes}" Value="False"><Setter TargetName="TimelineNote" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding EventType}" Value="completion">
                                                                <Setter TargetName="TimelineEvent" Property="Background" Value="#FAF8F0" />
                                                                <Setter TargetName="EventBadge" Property="Background" Value="#F2E9D1" />
                                                                <Setter TargetName="EventBadgeText" Property="Foreground" Value="#8C6526" />
                                                                <Setter TargetName="TimelineAction" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                <Setter TargetName="TimelineAction" Property="FontWeight" Value="SemiBold" />
