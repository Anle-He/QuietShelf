<ui:FluentWindow x:Class="QuietShelf.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="QuietShelf · 书影音" Width="1280" Height="800"
                 MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowCornerPreference="Round" Icon="Assets/app-icon.ico"
                 FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                 Foreground="{StaticResource TextBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="QuietIconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SectionEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="DemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="QuietShelf · 书影音" Icon="Assets/app-icon.ico" />

        <Grid Grid.Row="1" Background="{StaticResource PageBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource LibraryPaneBrush}">
                <Grid Margin="22,22,18,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="我的收藏" FontSize="26" FontWeight="DemiBold" />
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12">
                                <Run Text="书与影，安静地留在这里" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding VisibleWorks.Count, Mode=OneWay}" /><Run Text=" 部" />
                            </TextBlock>
                        </StackPanel>
                        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Primary"
                                   Content="添加" Icon="{ui:SymbolIcon Add24}" Click="AddWork_Click"
                                   Height="38" Padding="15,0" />
                    </Grid>

                    <ui:TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,20,0,0" Height="42"
                                PlaceholderText="搜索标题、副标题或作者" TextChanged="SearchBox_TextChanged" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,13,0,15">
                        <ui:Button x:Name="AllFilterButton" Content="全部" Tag="all" Appearance="Primary" Click="Filter_Click" Padding="15,5" />
                        <ui:Button x:Name="BookFilterButton" Content="书籍" Tag="book" Appearance="Secondary" Margin="7,0,0,0" Click="Filter_Click" Padding="15,5" />
                        <ui:Button x:Name="ScreenFilterButton" Content="影视" Tag="screen" Appearance="Secondary" Margin="7,0,0,0" Click="Filter_Click" Padding="15,5" />
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Border x:Name="EmptyState" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="26">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="54" Height="54" Background="{StaticResource AccentSoftBrush}" CornerRadius="18">
                                    <ui:SymbolIcon Symbol="Book24" FontSize="24" Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="EmptyTitle" Text="这里还没有作品" Margin="0,16,0,0"
                                           FontSize="17" FontWeight="DemiBold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyDescription" Text="先加入一本书，或一部想留下来的影视。"
                                           Margin="0,7,0,17" Foreground="{StaticResource MutedBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <ui:Button Content="添加第一部作品" Appearance="Primary" Click="AddWork_Click" />
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="WorkList" ItemsSource="{Binding VisibleWorks}" Background="Transparent"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="WorkList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <Border x:Name="ItemSurface" Padding="12" CornerRadius="12"
                                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <Border x:Name="SelectionMark" Width="4" Height="34" CornerRadius="2"
                                                            Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                                            VerticalAlignment="Center" Opacity="0" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                        <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
                                                        <Setter TargetName="SelectionMark" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="68" CornerRadius="7" Background="#E8ECE9"
                                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                                VerticalAlignment="Center" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=96}"
                                                       Stretch="Uniform" Margin="2">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasPrimaryCover}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding KindGlyph}" FontWeight="DemiBold" Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasPrimaryCover}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="DemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,5,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding StatusLabel, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LatestActivityLabel, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding AggregateRankLabel}" FontSize="13" FontWeight="DemiBold"
                                                       Foreground="{StaticResource ScoreBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ExperienceCountLabel}" Margin="0,4,0,0" FontSize="10.5"
                                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

            <Grid Grid.Column="2" Background="{StaticResource DetailPaneBrush}">
                <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="68" Height="68" CornerRadius="22" Background="{StaticResource AccentSoftBrush}">
                        <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="28" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="从一部作品开始" Margin="0,18,0,0" FontSize="21" FontWeight="DemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="选择左侧作品，回到某一次阅读或观看。" Margin="0,7,0,0"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26,22,26,30">
                        <Border x:Name="DetailHero" MinHeight="218" CornerRadius="22" Padding="26"
                                BorderBrush="{StaticResource HeroLineBrush}" BorderThickness="1"
                                Effect="{StaticResource HeroShadow}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EDF3EF" Offset="0" />
                                    <GradientStop Color="#F7F3EB" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="148" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="DetailCoverButton" Width="144" Height="194" Padding="0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        VerticalAlignment="Center" ToolTip="管理封面" Click="ManageCovers_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Canvas x:Name="DetailCoverCanvas" Width="140" Height="190" />
                                </Button>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,2,16,2">
                                    <TextBlock Text="作品档案" Style="{StaticResource SectionEyebrow}" Margin="0,0,0,11" />
                                    <TextBlock x:Name="DetailTitleText" FontSize="33" FontWeight="DemiBold"
                                               TextWrapping="Wrap" MaxHeight="88" />
                                     <TextBlock x:Name="DetailSubtitleText" Margin="0,7,0,0" FontSize="18"
                                                Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="54"
                                                Visibility="Collapsed" />
                                    <TextBlock x:Name="DetailAuthorText" Margin="0,7,0,0" FontSize="14"
                                               Foreground="{StaticResource MutedStrongBrush}" TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                    <Border Margin="0,14,0,0" Padding="10,5" CornerRadius="12"
                                            Background="#88FFFFFF" HorizontalAlignment="Left">
                                        <TextBlock x:Name="DetailMetaText" FontSize="12" Foreground="{StaticResource MutedStrongBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <ui:Button x:Name="PrimaryExperienceButton" Appearance="Primary" Click="PrimaryExperience_Click"
                                               MinWidth="108" Height="40" Padding="18,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <ui:Button Style="{StaticResource QuietIconButton}" Icon="{ui:SymbolIcon Edit24}"
                                                   ToolTip="编辑作品信息" Click="EditWork_Click" />
                                        <ui:Button Style="{StaticResource QuietIconButton}" Icon="{ui:SymbolIcon Delete24}"
                                                   ToolTip="删除作品" Click="DeleteWork_Click" Margin="4,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                CornerRadius="16" Padding="22,16" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="综合评分" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="DetailRankText" Margin="0,3,0,0" FontSize="24" FontWeight="DemiBold"
                                               Foreground="{StaticResource ScoreBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="1" Background="{StaticResource DividerBrush}" Margin="0,2" />
                                <StackPanel Grid.Column="2" Margin="20,0" VerticalAlignment="Center">
                                    <TextBlock Text="完成" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="DetailCountText" Margin="0,4,0,0" FontSize="16" FontWeight="DemiBold" />
                                </StackPanel>
                                <Border Grid.Column="3" Width="1" Background="{StaticResource DividerBrush}" Margin="0,2" />
                                <StackPanel Grid.Column="4" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="评分样本" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="DetailRatingCountText" Margin="0,4,0,0" FontSize="15" FontWeight="DemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="ActiveExperiencePanel" Margin="0,16,0,0" Background="{StaticResource ActiveSurfaceBrush}"
                                BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1" CornerRadius="18"
                                Padding="22" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="正在进行" Style="{StaticResource SectionEyebrow}" />
                                        <TextBlock x:Name="ActiveDateText" Margin="0,8,0,0" FontSize="18" FontWeight="DemiBold" />
                                        <TextBlock x:Name="ActiveSummaryText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ui:Button Content="放弃本次" Appearance="Transparent" Margin="0,0,8,0" Click="AbandonExperience_Click" />
                                        <ui:Button Content="记一下" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Click="AddProgress_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ProgressEmpty" Text="今天读了或看了多少，可以随手留在这里。"
                                           Margin="0,17,0,0" Foreground="{StaticResource MutedBrush}" />
                                <ItemsControl x:Name="ProgressList" ItemsSource="{Binding ProgressEntries}" Margin="0,14,0,0" Visibility="Collapsed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding LoggedOn, StringFormat={}{0:yyyy-MM-dd}}" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AmountLabel}" FontWeight="DemiBold" />
                                                    <TextBlock Grid.Column="2" Text="{Binding NotesLabel}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                        <ui:Button Tag="{Binding}" Style="{StaticResource QuietIconButton}" Icon="{ui:SymbolIcon Edit24}" ToolTip="编辑" Click="EditProgress_Click" />
                                                        <ui:Button Tag="{Binding}" Style="{StaticResource QuietIconButton}" Icon="{ui:SymbolIcon Delete24}" ToolTip="删除" Click="DeleteProgress_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid Margin="2,28,2,13">
                            <StackPanel>
                                <TextBlock Text="个人历程" Style="{StaticResource SectionEyebrow}" />
                                <TextBlock Text="历次完成" Margin="0,5,0,0" FontSize="22" FontWeight="DemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="HistoryCaptionText" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,2,2" Foreground="{StaticResource MutedBrush}" />
                        </Grid>
                        <Border x:Name="HistoryEmpty" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="28">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="5" BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="完成一次后，日期、总结和评分会留在这里。" Margin="0,9,0,0"
                                           HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="HistoryList" ItemsSource="{Binding CompletedExperiences}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <Border Width="2" Background="{StaticResource TimelineBrush}" HorizontalAlignment="Center" Margin="0,15,0,0" />
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource DetailPaneBrush}"
                                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="3"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
                                        </Grid>
                                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                                CornerRadius="16" Padding="20" Effect="{StaticResource CardShadow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DateRangeLabel}" FontSize="15" FontWeight="DemiBold" />
                                                    <TextBlock Text="{Binding ProgressSummaryLabel}" Margin="0,6,14,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding ScoresLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Text="{Binding NotesLabel}" Margin="0,7,18,0" TextWrapping="Wrap" MaxHeight="52" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <Border Background="{StaticResource ScoreSoftBrush}" CornerRadius="10" Padding="9,5">
                                                        <TextBlock Text="{Binding RankLabel}" HorizontalAlignment="Right" FontWeight="DemiBold" Foreground="{StaticResource ScoreBrush}" />
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,7,0,0">
                                                        <ui:Button Tag="{Binding}" Style="{StaticResource QuietIconButton}" Icon="{ui:SymbolIcon Edit24}" ToolTip="编辑" Click="EditExperience_Click" />
                                                        <ui:Button Tag="{Binding}" Style="{StaticResource QuietIconButton}" Icon="{ui:SymbolIcon Delete24}" ToolTip="删除" Click="DeleteExperience_Click" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
