<Application x:Class="QuietShelf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:QuietShelf.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PageBrush" Color="#F5F4F0" />
            <SolidColorBrush x:Key="LibraryPaneBrush" Color="#EFEEE9" />
            <SolidColorBrush x:Key="DetailPaneBrush" Color="#F7F6F2" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F8F8F4" />
            <SolidColorBrush x:Key="TextBrush" Color="#232622" />
            <SolidColorBrush x:Key="MutedBrush" Color="#636A64" />
            <SolidColorBrush x:Key="MutedStrongBrush" Color="#505852" />
            <SolidColorBrush x:Key="AccentBrush" Color="#2F5A47" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6EEE9" />
            <SolidColorBrush x:Key="AccentLineBrush" Color="#BFD0C5" />
            <SolidColorBrush x:Key="ActiveSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HeroLineBrush" Color="#DADDD7" />
            <SolidColorBrush x:Key="TimelineBrush" Color="#DADDD7" />
            <SolidColorBrush x:Key="ScoreBrush" Color="#A06A2A" />
            <SolidColorBrush x:Key="ScoreSoftBrush" Color="#F7F0E5" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#F6EEE0" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#F8E9E7" />
            <SolidColorBrush x:Key="DividerBrush" Color="#DADDD7" />

            <DropShadowEffect x:Key="CardShadow" Color="#273128" BlurRadius="12" ShadowDepth="2" Opacity="0.06" />
            <DropShadowEffect x:Key="HeroShadow" Color="#273128" BlurRadius="18" ShadowDepth="3" Opacity="0.12" />

            <CornerRadius x:Key="CardRadius">12</CornerRadius>
            <Thickness x:Key="PagePadding">28</Thickness>
            <Thickness x:Key="CardPadding">18</Thickness>
            <converters:CoverImageConverter x:Key="CoverImageConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
