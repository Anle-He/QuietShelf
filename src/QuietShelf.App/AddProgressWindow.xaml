<Window x:Class="QuietShelf.AddProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="记一下" Height="500" Width="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app-icon.ico"
        Background="{StaticResource PageBrush}" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="34">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="记一下" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="只记今天的进度和想法，不需要评分。" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,26,0,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="日期" Margin="0,0,0,7" />
                <DatePicker x:Name="LoggedOnPicker" Height="40" />
                <TextBlock Text="记录方式" Margin="0,18,0,7" />
                <ComboBox x:Name="MetricBox" SelectedIndex="0" Height="40" SelectionChanged="Metric_SelectionChanged">
                    <ComboBoxItem Tag="duration" Content="按时长" />
                    <ComboBoxItem x:Name="EpisodesOption" Tag="episodes" Content="按集数" />
                </ComboBox>
                <TextBlock x:Name="AmountLabel" Text="本次记录（分钟）" Margin="0,18,0,7" />
                <ui:TextBox x:Name="AmountBox" MaxLength="5" Height="40" PlaceholderText="例如 30" />
                <TextBlock x:Name="InputError" Foreground="#A33A32" Margin="2,6,0,0" Visibility="Collapsed" />
                <StackPanel x:Name="EpisodeTotalPanel" Visibility="Collapsed">
                    <TextBlock Text="总集数（可选）" Margin="0,18,0,7" />
                    <ui:TextBox x:Name="TotalEpisodesBox" MaxLength="5" Height="40" PlaceholderText="例如 12；不确定可留空" />
                    <TextBlock Text="这是整部作品的总集数，填写一次后会沿用到后续记录。"
                               Margin="2,6,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="随手记（可选）" Margin="0,18,0,7" />
                <ui:TextBox x:Name="NotesBox" Height="82" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000"
                            PlaceholderText="今天看到哪里，或者有什么感受" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="取消" Appearance="Secondary" Margin="0,0,10,0" Click="Cancel_Click" />
            <ui:Button x:Name="SaveButton" Content="保存记录" Icon="{ui:SymbolIcon Save24}"
                       Appearance="Primary" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
