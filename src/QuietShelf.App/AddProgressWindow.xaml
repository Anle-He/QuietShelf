<Window x:Class="QuietShelf.AddProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="记一下" Height="625" Width="540" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app-icon.ico"
        Background="{StaticResource PageBrush}" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource WarmSoftBrush}" VerticalAlignment="Top">
                <ui:SymbolIcon Symbol="Edit24" FontSize="20" Foreground="{StaticResource WarmBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="PROGRESS / 今日记录" Style="{StaticResource DialogEyebrowStyle}" Foreground="{StaticResource WarmBrush}"/>
                <TextBlock x:Name="HeadingText" Text="记一下" Style="{StaticResource DialogTitleStyle}" />
                <TextBlock Text="记下今天到了哪里，也可以只留一句感受。" Style="{StaticResource DialogDescriptionStyle}" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="ProgressFormSection" Style="{StaticResource FormSectionStyle}" Margin="0,0,8,0">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="记录日期" Style="{StaticResource FieldLabelStyle}"/><DatePicker x:Name="LoggedOnPicker" Height="42" /></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="记录方式" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="MetricBox" SelectedIndex="0" Height="42" SelectionChanged="Metric_SelectionChanged">
                    <ComboBoxItem Tag="duration" Content="按时长" />
                    <ComboBoxItem x:Name="EpisodesOption" Tag="episodes" Content="按集数" />
                  </ComboBox></StackPanel>
                </Grid>
                <TextBlock x:Name="AmountLabel" Text="本次记录（分钟）" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,7" />
                <ui:TextBox x:Name="AmountBox" MaxLength="5" Height="42" PlaceholderText="例如 30" />
                <TextBlock x:Name="InputError" Foreground="#A33A32" Margin="2,6,0,0" Visibility="Collapsed" />
                <StackPanel x:Name="EpisodeTotalPanel" Visibility="Collapsed">
                    <TextBlock Text="总集数（可选）" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7" />
                    <ui:TextBox x:Name="TotalEpisodesBox" MaxLength="5" Height="42" PlaceholderText="例如 12；不确定可留空" />
                    <TextBlock Text="整部作品的总集数，填写一次后会沿用到后续记录。" Style="{StaticResource FieldHintStyle}" />
                </StackPanel>
                <Border Margin="0,20,0,19" Height="1" Background="{StaticResource DividerBrush}"/>
                <TextBlock Text="随手记（可选）" Style="{StaticResource FieldLabelStyle}" />
                <ui:TextBox x:Name="NotesBox" Height="82" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000"
                            PlaceholderText="今天看到哪里，或者有什么感受" />
              </StackPanel>
            </Border>
        </ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource DialogActionBarStyle}"><Grid>
            <TextBlock Text="这次记录不会触发评分" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ui:Button Content="取消" Appearance="Secondary" Margin="0,0,10,0" Click="Cancel_Click" />
            <ui:Button x:Name="SaveButton" Content="保存记录" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="Save_Click" IsDefault="True" /></StackPanel>
        </Grid></Border>
    </Grid>
</Window>
