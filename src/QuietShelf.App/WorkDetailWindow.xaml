<Window x:Class="QuietShelf.WorkDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="作品详情" Height="780" Width="760" MinHeight="640" MinWidth="660"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app-icon.ico"
        Background="{StaticResource PageBrush}" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="42,34">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="MetaText" Margin="0,7,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="删除作品" Margin="0,0,10,0" Background="#E7E5DF" Click="DeleteWork_Click" />
                <Button x:Name="AddExperienceButton" Background="{StaticResource AccentBrush}" Foreground="White" Click="AddExperience_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,24,0,16" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="22,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="综合评分" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="AggregateRankText" Margin="0,4,0,0" FontSize="26" FontWeight="SemiBold" Foreground="#9A6823" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="RatingCountText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="ExperienceCountText" Margin="0,5,0,0" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="CurrentExperiencePanel" Grid.Row="2" Margin="0,0,0,18" Background="#EAF0EC" CornerRadius="12" Padding="20,17" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="当前一次" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="ActiveDateText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="ActiveSummaryText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="放弃本次" Margin="0,0,10,0" Background="#E7E5DF" Click="AbandonExperience_Click" />
                        <Button x:Name="AddProgressButton" Content="＋ 记一下" Background="{StaticResource AccentBrush}" Foreground="White" Click="AddProgress_Click" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ProgressEmpty" Text="还没有中途记录。今天读了或看了多少，可以随手记在这里。"
                           Margin="0,15,0,0" Foreground="{StaticResource MutedBrush}" />
                <ScrollViewer x:Name="ActiveProgressScroll" Margin="0,13,0,0" MaxHeight="150" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl ItemsSource="{Binding ProgressEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,8,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LoggedOn, StringFormat={}{0:yyyy-MM-dd}}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AmountLabel}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding NotesLabel}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Content="编辑" Tag="{Binding}" Margin="8,0,6,0" Padding="8,3" MinHeight="28" Background="#DDE7E1" Click="EditProgress_Click" />
                                        <Button Content="删除" Tag="{Binding}" Padding="8,3" MinHeight="28" Background="#EEE1DE" Click="DeleteProgress_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="历次完成" Margin="2,0,0,10" FontSize="15" FontWeight="SemiBold" />
            <Grid Grid.Row="1">
                <StackPanel x:Name="HistoryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="还没有完成记录" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="完成一次后，评分和总结会出现在这里。" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Experiences}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="18,15" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DateRangeLabel}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ProgressSummaryLabel}" Margin="0,5,8,0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ScoresLabel}" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding NotesLabel}" Margin="0,6,16,0" TextWrapping="Wrap" MaxHeight="48" Foreground="{StaticResource TextBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding RankLabel}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#9A6823" />
                                            <StackPanel Orientation="Horizontal" Margin="8,9,0,0">
                                                <Button Content="编辑" Tag="{Binding}" Margin="0,0,6,0" Padding="8,3" MinHeight="28" Background="#DDE7E1" Click="EditExperience_Click" />
                                                <Button Content="删除" Tag="{Binding}" Padding="8,3" MinHeight="28" Background="#EEE1DE" Click="DeleteExperience_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
